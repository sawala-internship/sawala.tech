{
  "name": "sawala-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit --incremental false",
    "lint:fix": "eslint src --fix",
    "test:tsc": "tsc -p . --noEmit",
    "lint:staged": "lint-staged",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "prettier:format": "prettier --write .",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "sh ./.husky/pre-commit",
      "pre-push": "sh ./.husky/pre-push",
      "commit-msg": "sh ./.husky/commit-msg"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@emotion/css": "^11.1.3",
    "@emotion/react": "^11.4.1",
    "@emotion/server": "^11.4.0",
    "@emotion/styled": "^11.3.0",
    "@headlessui/react": "^1.4.0",
    "axios": "^0.21.1",
    "next": "13.3.4",
    "nprogress": "^0.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-feather": "^2.0.9",
    "react-scroll": "^1.8.7",
    "react-slick": "^0.28.1",
    "sharp": "0.27.2",
    "swr": "^1.2.2"
  },
  "devDependencies": {
    "@babel/plugin-syntax-typescript": "^7.14.5",
    "@babel/preset-typescript": "^7.14.5",
    "@commitlint/cli": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@emotion/babel-plugin": "^11.3.0",
    "@next/eslint-plugin-next": "^12.1.6",
    "@testing-library/dom": "^8.1.0",
    "@testing-library/jest-dom": "^5.11.10",
    "@testing-library/react": "^12.0.0",
    "@types/jest": "^27.0.0",
    "@types/node": "18.19.0",
    "@types/nprogress": "^0.2.0",
    "@types/react": "18.0.30",
    "@types/react-dom": "18.0.11",
    "@types/react-scroll": "^1.8.4",
    "@types/react-slick": "^0.23.8",
    "@types/react-test-renderer": "^17.0.1",
    "@types/tailwindcss": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^4.29.0",
    "@typescript-eslint/parser": "4.29.1",
    "autoprefixer": "^10.2.3",
    "babel-jest": "^27.0.6",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-twin": "^1.0.2",
    "classnames": "^2.3.1",
    "eslint": "7.32.0",
    "eslint-config-next": "13.2.4",
    "eslint-config-prettier": "8.3.0",
    "eslint-plugin-import-helpers": "^1.3.1",
    "eslint-plugin-jsx-a11y": "6.4.1",
    "eslint-plugin-prettier": "3.4.0",
    "eslint-plugin-react": "7.24.0",
    "eslint-plugin-react-hooks": "4.2.0",
    "husky": "^7.0.0",
    "jest": "^27.0.6",
    "lint-staged": "^11.1.2",
    "postcss": "^8.4.5",
    "postcss-scss": "^4.0.9",
    "prettier": "^2.3.0",
    "react-test-renderer": "^17.0.2",
    "sass": "^1.49.8",
    "tailwind-filter-utilities": "^2.0.0",
    "tailwindcss": "^3.1.3",
    "twin.macro": "^2.6.2",
    "typescript": "^4.6.3"
  },
  "browser": {
    "buffer": false
  }
}
